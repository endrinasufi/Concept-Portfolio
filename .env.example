# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cma
DB_PASSWORD=
DB_NAME=cma_portfolio

# Auth
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me-on-first-login

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Media: local | cloudinary
MEDIA_STORAGE_PROVIDER=local
# Local uploads directory (dev)
MEDIA_LOCAL_DIR=storage/uploads

# Cloudinary (when MEDIA_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cma-portfolio

# Dev only: force browser IndexedDB instead of API (never in production)
NEXT_PUBLIC_USE_LOCAL_DATA=false
